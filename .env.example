PORT=3002
# Public URL of the app, no trailing slash. Used in emails, link previews and
# the calendar feed.
BASE_URL=http://localhost:3002
# On Railway, point this into a mounted Volume or data is wiped on redeploy.
DB_PATH=./data/slotlock.db

# Email via Resend (resend.com). Empty = emails are printed to the log, and
# password reset links appear there too.
RESEND_API_KEY=
EMAIL_FROM=Slotlock <bookings@example.com>

# Optional: charge artists for Slotlock itself. Leave empty for free early
# access. Clients' deposits never go through Stripe either way.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Signing secret of the webhook endpoint pointed at {BASE_URL}/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# Free trial for new artists once billing is on.
TRIAL_DAYS=14

# Set to 1 to skip building the /demo example page on boot.
DISABLE_DEMO=
# Set to 1 to turn off the background timer (hold expiry, reminders, cleanup).
DISABLE_SCHEDULER=
