PORT=3002
# Public URL of the app, no trailing slash. Used for Stripe redirects and
# links in emails.
BASE_URL=http://localhost:3002
# On Railway, point this into a mounted Volume or data is wiped on redeploy.
DB_PATH=./data/slotlock.db

# Set to 1 to create the example page at /demo on startup if it's missing.
SEED_DEMO=

# Stripe (Dashboard → Developers → API keys). Leave STRIPE_SECRET_KEY empty to
# run in demo mode: deposits and subscriptions are simulated, nothing charges.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint pointed at {BASE_URL}/webhooks/stripe
# Events: checkout.session.completed, checkout.session.expired,
#         customer.subscription.created/updated/deleted
STRIPE_WEBHOOK_SECRET=
# Recurring Price for the artist plan (e.g. $19/month).
STRIPE_PRICE_ID=

# Free trial length for new artists.
TRIAL_DAYS=14

# Email via Resend (resend.com). Empty = emails are printed to the log.
RESEND_API_KEY=
EMAIL_FROM=Slotlock <bookings@example.com>

# Set to 1 to turn off the reminder/cleanup timer.
DISABLE_SCHEDULER=
